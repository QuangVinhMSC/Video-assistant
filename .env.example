# Required
OPENAI_API_KEY=

# Optional — these are set automatically by docker-compose.yml when using Docker.
# Only set them here for local (non-Docker) development.
REDIS_URL=redis://localhost:6379
DATABASE_URL=sqlite:///data/video_assistant.db
FRONTEND_ORIGIN=http://localhost:5173

# Optional — if set, all requests require an X-API-Key header matching this value
API_KEY=
